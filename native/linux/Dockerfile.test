FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-gi python3-gi-cairo gir1.2-gtk-4.0 gir1.2-adw-1 \
    gir1.2-webkit-6.0 xvfb xauth dbus-x11 fonts-dejavu-core \
    desktop-file-utils shared-mime-info adwaita-icon-theme librsvg2-common fonts-cantarell \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
